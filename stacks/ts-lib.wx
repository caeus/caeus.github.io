import versions from 'wx:/versions'
import { buildPackageJson } from 'wx:/stacks/utils'

const CORE_DEV_DEPS = ['@tsconfig/strictest', 'typescript']

export function ciSuite({ name, scope, deps = [] }) {
  const pkgJson = buildPackageJson({ name, scope, deps, coreDevDeps: CORE_DEV_DEPS, versions })

  return {
    install: {
      deps: [],
      exports: ['/repo/node_modules'],
      run: (_deps) => [
        { FROM: 'node:22-alpine' },
        { RUN: 'corepack enable && corepack prepare pnpm@latest --activate' },
        { RUN: `echo '${JSON.stringify(pkgJson)}' > /repo/package.json` },
        { WORKDIR: '/repo' },
        { RUN: 'pnpm install --ignore-workspace --prod=false' },
      ]
    },
    pack: {
      deps: ['install'],
      run: (deps) => [
        { FROM: deps['install'] },
        { COPY: { src: '.', dest: '/repo' } },
        { WORKDIR: '/repo' },
        { RUN: 'pnpm pack --pack-destination /out' },
      ]
    },
    typecheck: {
      deps: ['install'],
      run: (deps) => [
        { FROM: deps['install'] },
        { COPY: { src: '.', dest: '/repo' } },
        { WORKDIR: '/repo' },
        { RUN: 'pnpm exec tsc --noEmit' },
      ]
    }
  }
}
