#!/bin/sh
set -e

WORKING_DIR="$(pwd)"
dir="$WORKING_DIR"

while [ "$dir" != "/" ]; do
  if [ -d "$dir/worxpace" ]; then
    WORKING_DIR="$WORKING_DIR" exec "$dir/worxpace/cli.sh" "$@"
  fi
  dir="$(dirname "$dir")"
done

echo "error: not inside a monorepo (no worxpace/ directory found in any parent)" >&2
exit 1
