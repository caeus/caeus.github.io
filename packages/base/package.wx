import { PNPM_VERSION } from 'wx:/lib/versions'
import { RECOMMENDED_IGNORE } from 'wx:/lib/dockerignore'

export default {
  ci: {
    'node-pnpm': {
      deps: [],
      run: (_deps) => ({
        FROM: 'node:22-alpine',
        steps: [
          { RUN: `corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate` },
        ],
        IGNORE: RECOMMENDED_IGNORE,
      })
    }
  }
}
