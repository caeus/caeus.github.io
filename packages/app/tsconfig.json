{
  "extends": "@tsconfig/strictest/tsconfig.json",
  "include": [
    "src/**/*"
  ],
  "compilerOptions": {
    "rootDir": "src",
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "types": [
      "@cloudflare/workers-types"
    ],
    "paths": {
      "#*": [
        "./src/*"
      ]
    }
  }
}
