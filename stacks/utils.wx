export const pnpmfile = (scope) => `function readPackage(pkg) {
  for (const depField of ['dependencies', 'devDependencies', 'peerDependencies', 'optionalDependencies']) {
    const deps = pkg[depField]
    if (!deps) continue
    for (const [name, version] of Object.entries(deps)) {
      if (version.startsWith('workspace:')) {
        const tarball = name.replace(/^@${scope}\\//, '').replace(/\\//g, '-')
        deps[name] = \`file:./\${tarball}.tgz\`
      }
    }
  }
  return pkg
}

module.exports = { hooks: { readPackage } }
`

export function buildPackageJson({ name, scope, deps = [], coreDeps = [], coreDevDeps = [], extra = {}, versions }) {
  const dependencies = Object.fromEntries([
    ...coreDeps.map(pkg => [pkg, versions[pkg]]),
    ...deps.map(d =>
      'local' in d
        ? [`@${scope}/${d.local}`, 'workspace:*']
        : [d.remote, versions[d.remote]]
    )
  ])
  const devDependencies = Object.fromEntries(
    coreDevDeps.map(pkg => [pkg, versions[pkg]])
  )
  return {
    name: `@${scope}/${name}`,
    version: '0.0.0',
    private: true,
    type: 'module',
    ...extra,
    dependencies,
    devDependencies,
  }
}
