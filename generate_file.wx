function base64Encode(str) {
  const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
  const bytes = []
  for (let i = 0; i < str.length; i++) {
    const c = str.charCodeAt(i)
    if (c < 0x80) bytes.push(c)
    else if (c < 0x800) bytes.push((c >> 6) | 0xc0, (c & 0x3f) | 0x80)
    else bytes.push((c >> 12) | 0xe0, ((c >> 6) & 0x3f) | 0x80, (c & 0x3f) | 0x80)
  }
  let result = ''
  for (let i = 0; i < bytes.length; i += 3) {
    result += chars[bytes[i] >> 2]
    result += chars[((bytes[i] & 3) << 4) | ((bytes[i + 1] ?? 0) >> 4)]
    result += i + 1 < bytes.length ? chars[((bytes[i + 1] & 0xf) << 2) | ((bytes[i + 2] ?? 0) >> 6)] : '='
    result += i + 2 < bytes.length ? chars[bytes[i + 2] & 0x3f] : '='
  }
  return result
}

export function writeText(path, content) {
  return { RUN: `echo "${base64Encode(content)}" | base64 -d > ${path}` }
}

export function writeJson(path, value) {
  return writeText(path, JSON.stringify(value, null, 2))
}

export function writeYaml(path, value) {
  return writeText(path, toYaml(value, 0))
}

function toYaml(value, depth) {
  const pad = '  '.repeat(depth)
  if (value === null || value === undefined) return 'null'
  if (typeof value === 'boolean' || typeof value === 'number') return String(value)
  if (typeof value === 'string') return value
  if (Array.isArray(value)) return value.map(v => `${pad}- ${toYaml(v, depth + 1)}`).join('\n')
  return Object.entries(value).map(([k, v]) =>
    typeof v === 'object' && v !== null
      ? `${pad}${k}:\n${toYaml(v, depth + 1)}`
      : `${pad}${k}: ${toYaml(v, depth + 1)}`
  ).join('\n')
}
