import versions from 'wx:/versions'
import { buildPackageJson } from 'wx:/stacks/utils'

const forgeEngine = 'packages/forge#ci#engine'
const forgePnpmfile = 'packages/forge#ci#pnpmfile'
const forgeTsExecutable = 'packages/forge#ci#ts-executable'

const CORE_DEV_DEPS = ['@tsconfig/strictest', '@cloudflare/workers-types', 'typescript', 'wrangler']

export function ciSuite({ name, scope, deps = [] }) {
  const localDeps = deps.filter(d => 'local' in d)
  const packTargets = localDeps.map(d => `packages/${d.local}#ci#pack`)
  const packageJson = buildPackageJson({
    name, scope, deps, coreDevDeps: CORE_DEV_DEPS, versions,
    extra: { pnpm: { onlyBuiltDependencies: ['esbuild', 'sharp', 'workerd'] } }
  })
  const scaffoldData = JSON.stringify({ scope, name, packageJson })

  return {
    scaffold: {
      deps: [forgeEngine, forgeTsExecutable],
      exports: ['/out/'],
      run: (deps) => [
        { FROM: 'node:22-alpine' },
        { COPY: { from: deps[forgeEngine], src: '/forge', dest: '/forge' } },
        { COPY: { from: deps[forgeTsExecutable], src: '/forge/templates/ts-executable', dest: '/forge/templates/ts-executable' } },
        { RUN: `node /forge/engine.js --template /forge/templates/ts-executable --data '${scaffoldData}' --out /out` },
      ]
    },
    pnpmfile: {
      deps: [forgeEngine, forgePnpmfile],
      run: (deps) => [
        { FROM: 'node:22-alpine' },
        { COPY: { from: deps[forgeEngine], src: '/forge', dest: '/forge' } },
        { COPY: { from: deps[forgePnpmfile], src: '/forge/templates/pnpmfile', dest: '/forge/templates/pnpmfile' } },
        { RUN: `node /forge/engine.js --template /forge/templates/pnpmfile --data '${JSON.stringify({ scope })}' --out /out` },
      ]
    },
    install: {
      deps: [...packTargets, 'scaffold', 'pnpmfile'],
      exports: ['/repo/node_modules'],
      run: (deps) => [
        { FROM: 'node:22-alpine' },
        { RUN: 'corepack enable && corepack prepare pnpm@latest --activate' },
        ...localDeps.map(d => ({
          COPY: { from: deps[`packages/${d.local}#ci#pack`], src: `/out/${scope}-${d.local}-0.0.0.tgz`, dest: `/repo/${d.local}.tgz` }
        })),
        { COPY: { from: deps['pnpmfile'], src: '/out/.pnpmfile.cjs', dest: '/repo/.pnpmfile.cjs' } },
        { COPY: { from: deps['scaffold'], src: '/out/package.json', dest: '/repo/package.json' } },
        { WORKDIR: '/repo' },
        { RUN: 'printf "allowBuilds:\\n  esbuild: true\\n  sharp: true\\n  workerd: true\\n" > pnpm-workspace.yaml && pnpm install --prod=false' },
      ]
    },
    typecheck: {
      deps: ['install'],
      run: (deps) => [
        { FROM: deps['install'] },
        { COPY: { src: '.', dest: '/repo' } },
        { WORKDIR: '/repo' },
        { RUN: 'pnpm exec tsc --noEmit' },
      ]
    }
  }
}
