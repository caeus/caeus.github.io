const forgeEngine = 'packages/forge#ci#engine'
const forgePnpmfile = 'packages/forge#ci#pnpmfile'
const forgeTsUi = 'packages/forge#ci#ts-ui'
const commonPack = 'packages/common#ci#pack'

export function ciSuite({ name, scope, outDir }) {
  return {
    scaffold: {
      deps: [forgeEngine, forgeTsUi],
      exports: ['/out/'],
      run: (deps) => [
        { FROM: 'node:22-alpine' },
        { COPY: { from: deps[forgeEngine], src: '/forge', dest: '/forge' } },
        { COPY: { from: deps[forgeTsUi], src: '/forge/templates/ts-ui', dest: '/forge/templates/ts-ui' } },
        { RUN: `node /forge/engine.js --template /forge/templates/ts-ui --data '${JSON.stringify({ scope, name, outDir })}' --out /out` },
      ]
    },
    pnpmfile: {
      deps: [forgeEngine, forgePnpmfile],
      run: (deps) => [
        { FROM: 'node:22-alpine' },
        { COPY: { from: deps[forgeEngine], src: '/forge', dest: '/forge' } },
        { COPY: { from: deps[forgePnpmfile], src: '/forge/templates/pnpmfile', dest: '/forge/templates/pnpmfile' } },
        { RUN: `node /forge/engine.js --template /forge/templates/pnpmfile --data '${JSON.stringify({ scope })}' --out /out` },
      ]
    },
    install: {
      deps: [commonPack, 'scaffold', 'pnpmfile'],
      exports: ['/repo/node_modules'],
      run: (deps) => [
        { FROM: 'node:22-alpine' },
        { RUN: 'corepack enable && corepack prepare pnpm@latest --activate' },
        { COPY: { from: deps[commonPack], src: `/out/${scope}-common-0.0.0.tgz`, dest: '/repo/common.tgz' } },
        { COPY: { from: deps['pnpmfile'], src: '/out/.pnpmfile.cjs', dest: '/repo/.pnpmfile.cjs' } },
        { COPY: { from: deps['scaffold'], src: '/out/package.json', dest: '/repo/package.json' } },
        { WORKDIR: '/repo' },
        { RUN: 'printf "allowBuilds:\\n  esbuild: true\\n" > pnpm-workspace.yaml && pnpm install --prod=false' },
      ]
    },
    typecheck: {
      deps: ['install'],
      run: (deps) => [
        { FROM: deps['install'] },
        { COPY: { src: '.', dest: '/repo' } },
        { WORKDIR: '/repo' },
        { RUN: 'pnpm exec tsc --noEmit' },
      ]
    },
    build: {
      deps: ['install'],
      run: (deps) => [
        { FROM: deps['install'] },
        { COPY: { src: '.', dest: '/repo' } },
        { WORKDIR: '/repo' },
        { RUN: 'pnpm exec vite build' },
      ]
    }
  }
}
