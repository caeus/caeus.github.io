import versions from 'wx:/versions'
import { buildPackageJson, pnpmfile } from 'wx:/stacks/utils'
import { writeJson, writeYaml, writeText } from 'wx:/generate_file'

const CORE_DEV_DEPS = ['@tsconfig/strictest', '@cloudflare/workers-types', 'typescript', 'wrangler']

const TSCONFIG = {
  extends: '@tsconfig/strictest/tsconfig.json',
  include: ['src/**/*'],
  compilerOptions: {
    rootDir: 'src',
    target: 'ES2022',
    lib: ['ES2022'],
    module: 'NodeNext',
    moduleResolution: 'NodeNext',
    noEmit: true,
    types: ['@cloudflare/workers-types'],
  }
}

const PRETTIERRC = {
  $schema: 'https://json.schemastore.org/prettierrc',
  semi: false,
  tabWidth: 2,
  singleQuote: true,
  printWidth: 100,
  trailingComma: 'none',
}

const BASE = 'packages/base#ci#node-pnpm'

export function ciSuite({ name, scope, deps = [] }) {
  const localDeps = deps.filter(d => 'local' in d)
  const packTargets = localDeps.map(d => `packages/${d.local}#ci#pack`)
  const packageJson = buildPackageJson({ name, scope, deps, coreDevDeps: CORE_DEV_DEPS, versions })

  return {
    install: {
      deps: [...packTargets, BASE],
      run: (deps) => [
        { FROM: deps[BASE] },
        ...localDeps.map(d => ({
          COPY: { from: deps[`packages/${d.local}#ci#pack`], src: `/out/${scope}-${d.local}-0.0.0.tgz`, dest: `/repo/${d.local}.tgz` }
        })),
        { WORKDIR: '/repo' },
        writeJson('/repo/package.json', packageJson),
        writeJson('/repo/tsconfig.json', TSCONFIG),
        writeJson('/repo/.prettierrc.json', PRETTIERRC),
        writeText('/repo/.pnpmfile.cjs', pnpmfile(scope)),
        writeYaml('/repo/pnpm-workspace.yaml', { allowBuilds: { esbuild: true, sharp: true, workerd: true } }),
        { RUN: 'pnpm install --prod=false' },
        { EXPORT: { src: '/repo/node_modules', dest: 'node_modules' } },
      ]
    },
    typecheck: {
      deps: ['install'],
      run: (deps) => [
        { FROM: deps['install'] },
        { COPY: { src: 'src', dest: '/repo/src' } },
        { WORKDIR: '/repo' },
        { RUN: 'pnpm exec tsc --noEmit' },
      ]
    }
  }
}
