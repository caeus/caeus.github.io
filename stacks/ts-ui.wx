import versions from 'wx:/versions'
import { buildPackageJson } from 'wx:/stacks/utils'

const forgeEngine = 'packages/forge#ci#engine'
const forgePnpmfile = 'packages/forge#ci#pnpmfile'
const forgeTsUi = 'packages/forge#ci#ts-ui'

const CORE_DEPS = [
  '@tailwindcss/vite', '@vitejs/plugin-react',
  'class-variance-authority', 'clsx',
  'react', 'react-dom', 'react-router-dom',
  'tailwind-merge', 'tailwindcss',
  'wyr-ts', 'zod',
]

const CORE_DEV_DEPS = [
  '@tsconfig/strictest', '@types/node', '@types/react', '@types/react-dom',
  '@typescript-eslint/eslint-plugin', '@typescript-eslint/parser',
  'eslint', 'prettier', 'typescript', 'vite',
]

export function ciSuite({ name, scope, outDir, deps = [] }) {
  const localDeps = deps.filter(d => 'local' in d)
  const packTargets = localDeps.map(d => `packages/${d.local}#ci#pack`)
  const packageJson = buildPackageJson({
    name, scope, deps,
    coreDeps: CORE_DEPS,
    coreDevDeps: CORE_DEV_DEPS,
    extra: {
      imports: { '#*': './src/*' },
      pnpm: { onlyBuiltDependencies: ['esbuild'] },
    },
    versions,
  })
  const scaffoldData = JSON.stringify({ scope, name, outDir, packageJson })

  return {
    scaffold: {
      deps: [forgeEngine, forgeTsUi],
      exports: ['/out/'],
      run: (deps) => [
        { FROM: 'node:22-alpine' },
        { COPY: { from: deps[forgeEngine], src: '/forge', dest: '/forge' } },
        { COPY: { from: deps[forgeTsUi], src: '/forge/templates/ts-ui', dest: '/forge/templates/ts-ui' } },
        { RUN: `node /forge/engine.js --template /forge/templates/ts-ui --data '${scaffoldData}' --out /out` },
      ]
    },
    pnpmfile: {
      deps: [forgeEngine, forgePnpmfile],
      run: (deps) => [
        { FROM: 'node:22-alpine' },
        { COPY: { from: deps[forgeEngine], src: '/forge', dest: '/forge' } },
        { COPY: { from: deps[forgePnpmfile], src: '/forge/templates/pnpmfile', dest: '/forge/templates/pnpmfile' } },
        { RUN: `node /forge/engine.js --template /forge/templates/pnpmfile --data '${JSON.stringify({ scope })}' --out /out` },
      ]
    },
    install: {
      deps: [...packTargets, 'scaffold', 'pnpmfile'],
      exports: ['/repo/node_modules'],
      run: (deps) => [
        { FROM: 'node:22-alpine' },
        { RUN: 'corepack enable && corepack prepare pnpm@latest --activate' },
        ...localDeps.map(d => ({
          COPY: { from: deps[`packages/${d.local}#ci#pack`], src: `/out/${scope}-${d.local}-0.0.0.tgz`, dest: `/repo/${d.local}.tgz` }
        })),
        { COPY: { from: deps['pnpmfile'], src: '/out/.pnpmfile.cjs', dest: '/repo/.pnpmfile.cjs' } },
        { COPY: { from: deps['scaffold'], src: '/out/package.json', dest: '/repo/package.json' } },
        { WORKDIR: '/repo' },
        { RUN: 'printf "allowBuilds:\\n  esbuild: true\\n" > pnpm-workspace.yaml && pnpm install --prod=false' },
      ]
    },
    typecheck: {
      deps: ['install'],
      run: (deps) => [
        { FROM: deps['install'] },
        { COPY: { src: '.', dest: '/repo' } },
        { WORKDIR: '/repo' },
        { RUN: 'pnpm exec tsc --noEmit' },
      ]
    },
    build: {
      deps: ['install'],
      run: (deps) => [
        { FROM: deps['install'] },
        { COPY: { src: '.', dest: '/repo' } },
        { WORKDIR: '/repo' },
        { RUN: 'pnpm exec vite build' },
      ]
    }
  }
}
